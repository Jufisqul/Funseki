  nodes:
  - id: again
    speaker: {fileID: 11400000, guid: 53cbcaa8574a1c241bea4856b1ba0619, type: 2}
    text: "\u041E\u043F\u044F\u0442\u044C \u0442\u044B? \u041B\u0430\u0434\u043D\u043E, \u0441\u043B\u0443\u0448\u0430\u0439 \u0435\u0449\u0451 \u0440\u0430\u0437."
    conditions:
    - kind: 0
      id: test_sato_talked
      value: 0
      hero: 0
    actions: []
    choices: []
    next: 
    end: 0
  - id: hello
    speaker: {fileID: 11400000, guid: 53cbcaa8574a1c241bea4856b1ba0619, type: 2}
    text: "\u041E, \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u0438\u0439! \u0422\u044B \u0432\u0435\u0434\u044C \u0438\u0437 2-\u0411?"
    conditions: []
    actions: []
    choices: []
    next: 
    end: 0
  - id: reply
    speaker: {fileID: 11400000, guid: b35d70ba55761a242a6cf3bd027340e9, type: 2}
    text: "\u0412\u0440\u043E\u0434\u0435 \u0434\u0430. \u0415\u0441\u043B\u0438 \u043C\u0435\u043D\u044F \u043D\u0435 \u043F\u0435\u0440\u0435\u0432\u0435\u043B\u0438, \u043F\u043E\u043A\u0430 \u044F \u0441\u043F\u0430\u043B."
    conditions: []
    actions: []
    choices: []
    next: 
    end: 0
  - id: ask
    speaker: {fileID: 11400000, guid: 53cbcaa8574a1c241bea4856b1ba0619, type: 2}
    text: "\u0421\u043B\u0443\u0448\u0430\u0439, \u0443 \u0442\u0435\u0431\u044F \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E \u043D\u0435\u0442 \u043B\u0438\u0448\u043D\u0435\u0439 \u043E\u0442\u0432\u0451\u0440\u0442\u043A\u0438?"
    conditions: []
    actions: []
    choices:
    - text: "\u041D\u0435\u0442, \u043D\u043E \u043C\u043E\u0433\u0443 \u043F\u043E\u0438\u0441\u043A\u0430\u0442\u044C."
      voice: 0
      conditions: []
      actions: []
      next: find
      end: 0
    - text: "\u0410 \u0437\u0430\u0447\u0435\u043C \u0442\u0435\u0431\u0435 \u043E\u0442\u0432\u0451\u0440\u0442\u043A\u0430?"
      voice: 0
      conditions: []
      actions: []
      next: why
      end: 0
    - text: "\u041D\u0435\u0442."
      voice: 0
      conditions: []
      actions: []
      next: no
      end: 0
    - text: "\u0421\u043A\u0430\u0436\u0438 \u0435\u043C\u0443, \u0447\u0442\u043E \u043E\u0442\u0432\u0451\u0440\u0442\u043A\u0430 \u2014 \u044D\u0442\u043E \u043A\u043B\u044E\u0447 \u043E\u0442 \u0443\u0447\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0439."
      voice: 1
      conditions: []
      actions:
      - kind: 0
        id: test_voice_used
        amount: 1
        item: {fileID: 0}
      next: voice
      end: 0
    next: 
    end: 0
  - id: find
    speaker: {fileID: 11400000, guid: 53cbcaa8574a1c241bea4856b1ba0619, type: 2}
    text: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u0414\u0435\u0440\u0436\u0438 \u043C\u0430\u0440\u043A\u0435\u0440, \u0432\u0434\u0440\u0443\u0433 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F."
    conditions: []
    actions:
    - kind: 3
      id: 
      amount: 1
      item: {fileID: 11400000, guid: 5e9ec1ec39f7ad945b9b3427ffa7a253, type: 2}
    choices: []
    next: bye
    end: 0
  - id: why
    speaker: {fileID: 11400000, guid: 53cbcaa8574a1c241bea4856b1ba0619, type: 2}
    text: "\u042D\u0442\u043E \u0441\u0435\u043A\u0440\u0435\u0442. \u041E\u0447\u0435\u043D\u044C \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u0439 \u0441\u0435\u043A\u0440\u0435\u0442."
    conditions: []
    actions: []
    choices: []
    next: bye
    end: 0
  - id: no
    speaker: {fileID: 11400000, guid: 53cbcaa8574a1c241bea4856b1ba0619, type: 2}
    text: "\u0416\u0430\u043B\u044C. \u041F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u043E\u0442\u043A\u0440\u0443\u0447\u0438\u0432\u0430\u0442\u044C \u043D\u043E\u0433\u0442\u044F\u043C\u0438."
    conditions: []
    actions: []
    choices: []
    next: bye
    end: 0
  - id: voice
    speaker: {fileID: 11400000, guid: b35d70ba55761a242a6cf3bd027340e9, type: 2}
    text: "\u0412\u043E\u043E\u0431\u0449\u0435-\u0442\u043E \u043E\u0442\u0432\u0451\u0440\u0442\u043A\u0430 \u2014 \u044D\u0442\u043E \u043A\u043B\u044E\u0447 \u043E\u0442 \u0443\u0447\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0439."
    conditions: []
    actions: []
    choices: []
    next: 
    end: 0
  - id: bye
    speaker: {fileID: 11400000, guid: 53cbcaa8574a1c241bea4856b1ba0619, type: 2}
    text: "\u041B\u0430\u0434\u043D\u043E, \u0441\u043A\u043E\u0440\u043E \u0437\u0432\u043E\u043D\u043E\u043A. \u0423\u0432\u0438\u0434\u0438\u043C\u0441\u044F \u043D\u0430 \u0444\u0438\u0437\u0440\u0435!"
    conditions: []
