  m_Script: {fileID: 11500000, guid: 1a4e99b0fe0caac41a95fc89c90e9e90, type: 3}
  m_Name: BarkSet_Test
  m_EditorClassIdentifier: Funseki.Dialogue::Funseki.Dialogue.BarkSet
  lines:
  - text: "\u041D\u0435 \u0442\u043E\u043B\u043A\u0430\u0439\u0441\u044F, \u044F \u0442\u0443\u0442 \u0441\u0442\u043E\u044E."
    conditions: []
  - text: "\u0422\u044B \u0442\u043E\u0436\u0435 \u043E\u043F\u043E\u0437\u0434\u0430\u043B?"
    conditions: []
  - text: "\u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0432 \u0441\u043F\u043E\u0440\u0442\u0437\u0430\u043B\u0435 \u0436\u0438\u0432\u0451\u0442 \u043F\u0440\u0438\u0432\u0438\u0434\u0435\u043D\u0438\u0435."
    conditions: []
  - text: "\u0423 \u043C\u0435\u043D\u044F \u0437\u0430\u0432\u0442\u0440\u0430\u043A \u0443\u0431\u0435\u0436\u0430\u043B. \u0411\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E."
    conditions: []
  - text: "\u041A\u043B\u044E\u0447 \u043E\u0442 \u0443\u0447\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0439, \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C?.."
    conditions:
    - kind: 0
      id: test_voice_used
      value: 0
      hero: 0
