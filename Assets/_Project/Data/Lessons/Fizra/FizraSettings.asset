  noWhistleIntro:
  - speaker: 0
    text: "*\u0441\u0432\u0438\u0441\u0442\u0438\u0442 \u0432 \u043F\u0430\u043B\u044C\u0446\u044B* \u0424\u044C\u044E\u044E-\u0444\u044C!"
