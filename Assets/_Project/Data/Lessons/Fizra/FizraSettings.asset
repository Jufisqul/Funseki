  helperTeaseChance: 0.5
  helperTeaseLines:
  - "\u042D\u0442\u043E \u0431\u044B\u043B \u043D\u0435 \u0442\u043E\u0442 \u0441\u0432\u0438\u0441\u0442\u043E\u043A!"
  - "\u0421\u043E\u043A \u043C\u043E\u0439, \u0441\u043E\u043A \u043C\u043E\u0439!"
  - "\u041A\u0440\u0430\u0441\u0438\u0432\u043E. \u041D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E, \u043D\u043E \u043A\u0440\u0430\u0441\u0438\u0432\u043E."
