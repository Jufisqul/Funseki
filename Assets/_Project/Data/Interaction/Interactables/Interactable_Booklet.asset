  pages:
  - title: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C \u0432 \xAB\u0424\u0443\u043D\u0441\u044D\u043A\u0438\xBB!"
    image: {fileID: 2800000, guid: fed8a132c94897146bd4c216c5a586e5, type: 3}
    text: "\u0428\u043A\u043E\u043B\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u0432 1974 \u0433\u043E\u0434\u0443 \u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F \u0441\u043F\u044F\u0449\u0435\u0433\u043E \u0432\u0443\u043B\u043A\u0430\u043D\u0430. \xAB\u0424\u0443\u043D\u0441\u044D\u043A\u0438\xBB \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \xAB\u0432\u0443\u043B\u043A\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0431\u043E\u043C\u0431\u044B\xBB. \u0414\u0440\u0443\u0433\u0438\u0445 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439 \u0443 \u044D\u0442\u043E\u0433\u043E \u0441\u043B\u043E\u0432\u0430 \u043D\u0435\u0442."
  - title: "\u041F\u0435\u0440\u0432\u044B\u0439 \u044D\u0442\u0430\u0436"
    image: {fileID: 2800000, guid: 7159aa5855d43ca419e582b8b6db3e8b, type: 3}
    text: "\u0412\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435\u0441\u044C \u0443 \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E \u0432\u0445\u043E\u0434\u0430. \u041B\u0438\u0444\u0442 \u0435\u0437\u0434\u0438\u0442 \u0441 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u044D\u0442\u0430\u0436\u0430 \u043D\u0430 \u043F\u0435\u0440\u0432\u044B\u0439. \u041B\u0435\u0441\u0442\u043D\u0438\u0446\u0430 \u043D\u0430 \u0442\u0440\u0435\u0442\u0438\u0439 \u044D\u0442\u0430\u0436 \u0432\u0435\u0434\u0451\u0442 \u043A \u0441\u043E\u0432\u0435\u0449\u0430\u043D\u0438\u044E. \u041D\u0435 \u043C\u0435\u0448\u0430\u0439\u0442\u0435 \u0441\u043E\u0432\u0435\u0449\u0430\u043D\u0438\u044E."
  - title: "\u041F\u0440\u0430\u0432\u0438\u043B\u0430 \u0448\u043A\u043E\u043B\u044B"
    image: {fileID: 0}
    text: "1. \u0421\u043C\u0435\u043D\u043D\u0430\u044F \u043E\u0431\u0443\u0432\u044C \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u0430.\n2. \u0411\u0435\u0433\u0430\u0442\u044C \u043F\u043E \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430\u043C \u0437\u0430\u043F\u0440\u0435\u0449\u0435\u043D\u043E.\n3. \u0428\u0443\u043C\u0435\u0442\u044C \u0437\u0430\u043F\u0440\u0435\u0449\u0435\u043D\u043E.\n4. \u0417\u0430\u0434\u0430\u0432\u0430\u0442\u044C \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u043E \u0442\u0440\u0435\u0442\u044C\u0435\u043C \u044D\u0442\u0430\u0436\u0435 \u0437\u0430\u043F\u0440\u0435\u0449\u0435\u043D\u043E.\n5. \u0415\u0441\u043B\u0438 \u0432\u0430\u0441 \u0432\u044B\u0437\u0432\u0430\u043B\u0438 \u043D\u0430 \u0441\u043E\u0432\u0435\u0449\u0430\u043D\u0438\u0435, \u044D\u0442\u043E \u0434\u043B\u044F \u0432\u0430\u0448\u0435\u0433\u043E \u0436\u0435 \u0431\u043B\u0430\u0433\u0430."
