  memeInterval: {x: 45, y: 110}
  memeStates: 03000000i
  memeClip: {fileID: 0}
  memeVolume: 0.8
  memeLines:
  - "\u0425\u0430! \u041A\u043E\u0442 \u0432 \u0432\u0435\u0434\u0440\u0435. \u041E\u043F\u044F\u0442\u044C."
  - "\u041A\u0442\u043E \u043F\u0440\u0438\u0441\u043B\u0430\u043B \u043C\u0435\u043C \u043F\u0440\u043E \u0444\u0438\u0437\u0440\u0443\u043A\u0430?.."
  - "\u041C\u041C\u0421 \u0433\u0440\u0443\u0437\u0438\u0442\u0441\u044F \u0443\u0436\u0435 \u043C\u0438\u043D\u0443\u0442\u0443. \u042D\u0442\u043E \u0442\u043E\u0447\u043D\u043E \u043C\u0435\u043C."
