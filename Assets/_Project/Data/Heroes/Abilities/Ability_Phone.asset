  displayName: "\u0422\u0435\u043B\u0435\u0444\u043E\u043D"
  description: "\u0420\u0430\u0437 \u0437\u0430 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u0443: \u0437\u0432\u043E\u043D\u043E\u043A, \u043F\u043E\u0441\u043B\u0435 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0437\u043D\u0430\u0435\u0448\u044C \u0447\u0443\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435. \u0418\u043D\u043E\u0433\u0434\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442 \u043C\u0435\u043C\u044B."
  cooldown: 1
  usesPerBreak: 1
  cooldownLine: 
  outOfUsesLine: "\u0411\u0430\u043B\u0430\u043D\u0441 \u043D\u0430 \u043D\u0443\u043B\u0435. \u0414\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u044B."
  rumors: {fileID: 11400000, guid: 034e08edd5093de41b4ec687d05f0c44, type: 2}
  noRumorLine: "\u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0431\u0435\u0440\u0451\u0442 \u0442\u0440\u0443\u0431\u043A\u0443."
