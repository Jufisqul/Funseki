  - id: 1
    speaker: {fileID: 11400000, guid: 43d04e46c7950e8499ff3e9f04d73487, type: 2}
    text: "\u0420\u044D\u0439! \u0421\u043B\u0443\u0448\u0430\u0439. \u0424\u0438\u0437\u0440\u0443\u043A \u043D\u0430 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u0432\u0438\u0441\u0442\u043E\u043A \u043D\u0430 \u043F\u043E\u0434\u043E\u043A\u043E\u043D\u043D\u0438\u043A\u0435 \u0443 \u0441\u043F\u043E\u0440\u0442\u0437\u0430\u043B\u0430."
    conditions: []
    actions: []
    choices: []
    next: 
    end: 0
  - id: 2
    speaker: {fileID: 11400000, guid: 4855599b67c711948b1e13f36cddf2bd, type: 2}
    text: "\u0418 \u0437\u0430\u0447\u0435\u043C \u043C\u043D\u0435 \u044D\u0442\u043E \u0437\u043D\u0430\u0442\u044C?"
    conditions: []
    actions: []
    choices: []
    next: 
    end: 0
  - id: 3
    speaker: {fileID: 11400000, guid: 43d04e46c7950e8499ff3e9f04d73487, type: 2}
    text: "\u041D\u0443 \u043C\u0430\u043B\u043E \u043B\u0438. \u0411\u0435\u0437 \u0441\u0432\u0438\u0441\u0442\u043A\u0430 \u043E\u043D \u0442\u043E\u043B\u044C\u043A\u043E \u043C\u0430\u0448\u0435\u0442 \u0440\u0443\u043A\u0430\u043C\u0438. \u041A\u0430\u043A \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0430."
